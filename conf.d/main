#!/bin/bash -ex

DB_NAME=leantime
DB_USER=leantime
DB_PASS=$(mcookie)

ADMIN_MAIL="admin%40example.com" # '@' encoded = '%40'
ADMIN_PASS='TurnKey1!'

SRC=/usr/local/src
WEBROOT=/var/www/leantime
CONF=$WEBROOT/config/configuration.php
VERSION=v3.9.8
ARCHIVE=$SRC/Leantime-$VERSION.tar.gz
COOKIE=/run/leantime-install-cookie

mkdir -p "$WEBROOT"
tar xf "$ARCHIVE" -C "$WEBROOT" --no-same-owner --no-same-permissions
rm -f "$ARCHIVE"
cp "$(dirname "$CONF")/configuration.sample.php" "$CONF"
chown -R www-data:www-data "$WEBROOT"

service mysql start

mysqladmin create $DB_NAME
mysql --batch --execute "grant all privileges on $DB_NAME.* to $DB_USER@localhost identified by '$DB_PASS'; flush privileges;"

sed -i "\|\$sitename =|s|=.*|= 'TurnKey Leantime';|" $CONF
sed -i "\|\$dbUser =|s|=.*|= '$DB_USER';|" $CONF
sed -i "\|\$dbPassword =|s|=.*|= '$DB_PASS';|" $CONF
sed -i "\|\$dbDatabase =|s|=.*|= '$DB_NAME';|" $CONF
sed -i "\|\$sessionpassword =|s|=.*|= '$(mcookie)$(mcookie)';|" $CONF

a2dissite 000-default
a2ensite leantime
a2enmod headers
a2enmod rewrite

service apache2 start

CURL=(curl -c "$COOKIE" -b "$COOKIE")
INSTALL_URL="$("${CURL[@]}" -X POST -s -o /dev/null -w '%{redirect_url}' 'http://localhost/install' --data-raw "email=$ADMIN_MAIL&firstname=Turnkey&lastname=Linux&company=TurnkeyLinux&install=Install")"
"${CURL[@]}" -X POST "$INSTALL_URL" --data-raw "step=1&name=TurnkeyLinux Leantime&jobTitle=admin&password=$ADMIN_PASS&saveAccount=1&createAccount=Next"
"${CURL[@]}" -X POST "$INSTALL_URL" --data-raw "step=2&theme=default&themeFont=Roboto&createAccount=Next"
"${CURL[@]}" -X POST "$INSTALL_URL" --data-raw "step=3&colormode=light&colorscheme=companyColors&createAccount=Next"
"${CURL[@]}" -X POST "$INSTALL_URL" --data-raw "step=4&daySchedule-workStart-button=8&daySchedule-workStart=0&daySchedule-launch-button=12&daySchedule-launch=0&daySchedule-workEnd-button=16&daySchedule-workEnd=0&createAccount=Next"
"${CURL[@]}" -X POST "$INSTALL_URL" --data-raw "step=5&complete=1&createAccount=Complete Sign up"

# Keep application, vendor, and configuration code out of the web service's
# write boundary. Only documented runtime data paths remain writable.
chown -R root:root "$WEBROOT"
find "$WEBROOT" -type d -exec chmod 0755 {} +
find "$WEBROOT" -type f -exec chmod 0644 {} +
for runtime_dir in storage userfiles backupdb; do
    install -d -o www-data -g www-data -m 0750 "$WEBROOT/$runtime_dir"
    chown -R www-data:www-data "$WEBROOT/$runtime_dir"
done
chown root:www-data "$CONF"
chmod 0640 "$CONF"
rm -f "$COOKIE"

service mysql stop
service apache2 stop
